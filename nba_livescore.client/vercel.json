{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nba-livescore-api.onrender.com/api/$1"
    },
    {
      "source": "/NBAHub(.*)",
      "destination": "https://nba-livescore-api.onrender.com/NBAHub$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
